{
  "name": "signalk-portainer",
  "version": "0.1.0",
  "description": "Signal K plugin that manages Portainer CE over its HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "signalk": {
    "displayName": "Portainer"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "portainer",
    "docker",
    "containers"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run clean && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEGustafsson/signalk-portainer.git"
  },
  "author": "Karl-Erik Gustafsson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-portainer/issues"
  },
  "homepage": "https://github.com/KEGustafsson/signalk-portainer#readme",
  "engines": {
    "node": ">=20.18.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.31.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
