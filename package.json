{
  "name": "signalk-portainer",
  "version": "0.1.1",
  "description": "Signal K plugin that manages Portainer CE over its HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "signalk": {
    "displayName": "Portainer",
    "appIcon": "logo.svg",
    "screenshots": [
      "docs/images/panel-containers.png",
      "docs/images/plugin-config.png"
    ]
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-embeddable-webapp",
    "portainer",
    "docker",
    "containers"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:webapp",
    "clean": "node -e \"for (const d of ['dist','coverage','public']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run clean && npm run lint && npm run format:check && npm run test && npm run build",
    "build:plugin": "tsc -p tsconfig.build.json",
    "build:webapp": "webpack --config webpack.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEGustafsson/signalk-portainer.git"
  },
  "author": "Karl-Erik Gustafsson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-portainer/issues"
  },
  "homepage": "https://github.com/KEGustafsson/signalk-portainer#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "assets",
    "dist",
    "public",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/images/panel-containers.png",
    "docs/images/plugin-config.png"
  ],
  "dependencies": {
    "body-parser": "^1.20.6",
    "undici": "^7.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.31.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "express": "^4.21.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.0.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  }
}
